{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thiagopatzdorf/Matematica/problems/schema/cartao.schema.json",
  "title": "Cartão de Problema v1",
  "description": "Para editores (autocompletar e erro na hora). A fonte da verdade das regras de ciclo de vida é tools/problems/lifecycle.py; o validador tools/problems/validate.py aplica este esquema e mais as regras que JSON Schema não expressa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formato", "id", "titulo", "dominio", "tipo", "enunciado", "estado", "melhor_conhecido", "nosso", "avaliador", "historico"],
  "properties": {
    "formato": {"const": "cartao-problema/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$", "description": "slug estável; nunca muda, nem se o título mudar"},
    "titulo": {"type": "string", "minLength": 3},
    "dominio": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "tipo": {"enum": ["cota_superior", "cota_inferior", "valor_exato", "construcao", "formalizacao"]},
    "enunciado": {"type": "string", "minLength": 10},
    "enunciado_formal": {"type": ["string", "null"], "description": "nome da declaração Lean que formaliza o enunciado"},
    "estado": {"enum": ["proposto", "aceito", "aberto", "reivindicado", "candidato", "verificado", "certificado", "publicado", "refutado", "arquivado"]},
    "melhor_conhecido": {
      "type": "object", "additionalProperties": false, "required": ["valor", "fonte", "ref"],
      "properties": {
        "valor": {"type": ["number", "null"]},
        "fonte": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "intervalo": {"type": "object", "additionalProperties": false, "required": ["lb", "ub"],
                      "properties": {"lb": {"type": "number"}, "ub": {"type": "number"}}}
      }
    },
    "nosso": {
      "type": "object", "additionalProperties": false, "required": ["valor", "estado", "prova"],
      "properties": {
        "valor": {"type": ["number", "null"]},
        "estado": {"enum": ["nenhum", "computacional", "lrat", "lean"]},
        "prova": {"type": ["string", "null"], "description": "declaração Lean, caminho de certificado ou do código"}
      }
    },
    "avaliador": {
      "type": "object", "additionalProperties": false, "required": ["id", "como_rodar", "custo_estimado_usd"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "como_rodar": {"type": "string", "minLength": 1},
        "custo_estimado_usd": {"type": "number", "minimum": 0}
      }
    },
    "celula_ledger": {"type": ["string", "null"], "pattern": "^K[0-9]+\\([0-9]+,[0-9]+\\)$"},
    "historico": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["quem", "papel", "quando", "de", "para", "evidencia"],
        "properties": {
          "quem": {"type": "string", "minLength": 1},
          "papel": {"enum": ["qualquer", "mantenedor", "avaliador", "dono", "sistema"]},
          "quando": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
          "de": {"type": ["string", "null"]},
          "para": {"enum": ["proposto", "aceito", "aberto", "reivindicado", "candidato", "verificado", "certificado", "publicado", "refutado", "arquivado"]},
          "evidencia": {"type": "object"},
          "origem": {"const": "importacao"}
        }
      }
    }
  }
}
