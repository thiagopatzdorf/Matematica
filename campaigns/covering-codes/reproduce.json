{
  "campaign_id": "covering-codes",
  "schema": "genesis-math/reproduce/v1",
  "steps": [
    {
      "id": "ambiente",
      "report_versions": [
        "cc",
        "python3"
      ],
      "requires": [
        "cc",
        "python3"
      ],
      "type": "ambiente"
    },
    {
      "id": "hashes-dos-witnesses",
      "type": "hashes"
    },
    {
      "command": [
        "bash",
        "tools/verify/check_all.sh"
      ],
      "id": "check-all-verify-c",
      "timeout_s": 600,
      "type": "dados"
    },
    {
      "command": [
        "python3",
        "scripts/codes/build_structured.py",
        "--check"
      ],
      "id": "estrutura-regenera",
      "timeout_s": 600,
      "type": "gerador"
    },
    {
      "command": [
        "python3",
        "-m",
        "unittest",
        "tests.test_code_format.GeneratorsRegenerateTheCodes",
        "-v"
      ],
      "id": "gerador-1285",
      "timeout_s": 600,
      "type": "gerador"
    },
    {
      "command": [
        "python3",
        "scripts/k261/sc_ref.py",
        "6",
        "10",
        "2"
      ],
      "id": "espelho-busca-k2-6-1",
      "timeout_s": 120,
      "type": "gerador"
    },
    {
      "command": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "id": "testes-unittest",
      "timeout_s": 900,
      "type": "teste"
    },
    {
      "id": "verificadores-sobre-witnesses",
      "type": "verificadores"
    },
    {
      "id": "lake-build-alvo-padrao",
      "lean_root": ".",
      "nota": "alvo padrão CoveringLean (8942 jobs); CoveringHeavy (~12,4 h de CPU) NÃO está aqui",
      "opcional": true,
      "target": null,
      "type": "lean_build"
    },
    {
      "id": "axiomas-dos-registros-formais",
      "type": "axiomas"
    },
    {
      "id": "auditoria-da-cadeia",
      "type": "auditoria"
    }
  ]
}
